PORT=4100
# Must equal the platform's JWT_SECRET (the shipped value matches the platform's dev default)
JWT_SECRET=crime-narcotics-intel-platform-secret-key-2026
AUTH_REQUIRED=true

# Where scored zones come from:
#   crime_intel_backend -> read the running SafeGrid platform's GET /api/hotspots
#   sample              -> canned data, no platform needed
SCORING_SOURCE=crime_intel_backend
CRIME_INTEL_BASE_URL=http://localhost:8080
# Optional service login, used only when a request carries no bearer token
CRIME_INTEL_SERVICE_BADGE_ID=SUPER-101
CRIME_INTEL_SERVICE_PASSWORD=supervisor_pass

# LLM_PROVIDER: "mock" (deterministic, offline) or "ibm_watsonx" (real call)
LLM_PROVIDER=mock

# --- Only needed when LLM_PROVIDER=ibm_watsonx ---
# Never commit a real key. Put it in .env locally or in your secret store.
IBM_API_KEY=
IBM_PROJECT_ID=
IBM_URL=https://us-south.ml.cloud.ibm.com
IBM_MODEL_ID=ibm/granite-13b-instruct-v2
