# SafeGrid environment variables. NEVER commit a real .env (it is git-ignored).
# The platform (src/platform) runs with no configuration; the AI brief service
# reads src/explain-report-service/.env — copy src/explain-report-service/.env.example there.

# Shared by BOTH services. Must be identical. The platform falls back to a
# dev-only default if unset; set a long random value for anything shared.
JWT_SECRET=crime-narcotics-intel-platform-secret-key-2026

# --- AI brief service ---
PORT=4100
SCORING_SOURCE=crime_intel_backend
CRIME_INTEL_BASE_URL=http://localhost:8080
# Optional service login, used only when a request carries no bearer token
CRIME_INTEL_SERVICE_BADGE_ID=SUPER-101
CRIME_INTEL_SERVICE_PASSWORD=supervisor_pass

# LLM provider: "mock" (offline, default) or "ibm_watsonx"
LLM_PROVIDER=mock
# Only for LLM_PROVIDER=ibm_watsonx (put real values in .env only)
IBM_API_KEY=
IBM_PROJECT_ID=
IBM_URL=https://us-south.ml.cloud.ibm.com
IBM_MODEL_ID=ibm/granite-13b-instruct-v2
